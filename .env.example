############
# Supabase + MinIO - environment template
#
# Do not edit secrets by hand. Generate a fresh .env with:
#   make env            (or: ./scripts/gen-env.sh)
# Every value marked "generated" is replaced with a random secret.
# .env is git-ignored; never commit it.
############

# Compose project name: prefixes containers, networks and volumes.
COMPOSE_PROJECT_NAME=supabase-minio

# Optional services (comma separated): realtime, functions, analytics, pooler
# Example: COMPOSE_PROFILES=realtime,functions
COMPOSE_PROFILES=


############
# Host ports - all bound to 127.0.0.1 only
############

# API gateway: REST, Auth, Storage, Realtime, Functions and Studio (at /)
API_HOST_PORT=58000
# Direct Postgres access (superuser-capable, keep local)
DB_HOST_PORT=58432
# MinIO S3 API and web console (admin access to raw objects)
MINIO_API_HOST_PORT=58900
MINIO_CONSOLE_HOST_PORT=58901
# Supavisor (profile: pooler) session and transaction mode
POOLER_SESSION_HOST_PORT=58433
POOLER_TRANSACTION_HOST_PORT=58543


############
# Secrets (generated)
############

POSTGRES_PASSWORD=generated
JWT_SECRET=generated
# HS256 JWTs signed with JWT_SECRET (role anon / service_role)
ANON_KEY=generated
SERVICE_ROLE_KEY=generated

# Studio basic auth (served at http://127.0.0.1:API_HOST_PORT/)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=generated

SECRET_KEY_BASE=generated
REALTIME_DB_ENC_KEY=generated
VAULT_ENC_KEY=generated
PG_META_CRYPTO_KEY=generated
LOGFLARE_PUBLIC_ACCESS_TOKEN=generated
LOGFLARE_PRIVATE_ACCESS_TOKEN=generated

# Storage S3 protocol endpoint (/storage/v1/s3), for rclone / AWS CLI
S3_PROTOCOL_ACCESS_KEY_ID=generated
S3_PROTOCOL_ACCESS_KEY_SECRET=generated

# MinIO root account (used only by minio and minio-init)
MINIO_ROOT_USER=generated
MINIO_ROOT_PASSWORD=generated
# Bucket-scoped MinIO user that Supabase Storage uses
STORAGE_S3_ACCESS_KEY=generated
STORAGE_S3_SECRET_KEY=generated

# Opaque API keys and asymmetric (ES256) signing keys are not generated by
# this template; Envoy runs in legacy API key mode. To add them, see
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# URLs - change when exposing behind a reverse proxy
############

# Public base URL of the API gateway (as seen by browsers and apps)
SUPABASE_PUBLIC_URL=http://127.0.0.1:58000
API_EXTERNAL_URL=http://127.0.0.1:58000/auth/v1


############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
# Port inside the Docker network (host port is DB_HOST_PORT)
POSTGRES_PORT=5432


############
# Supavisor (profile: pooler)
############

POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=generated
POOLER_DB_POOL_SIZE=5


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
# Set to true together with COMPOSE_PROFILES=analytics
STUDIO_LOGS_ENABLED=false
# Optional, enables the Studio AI assistant
OPENAI_API_KEY=


############
# Auth
############

SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
# No SMTP server is configured: autoconfirm is off, so set real SMTP values
# below before relying on email sign-up.
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false


############
# Storage
############

# MinIO bucket that holds all Supabase Storage objects
GLOBAL_S3_BUCKET=supabase-storage
REGION=us-east-1
STORAGE_TENANT_ID=stub
# Max upload size in bytes (50 MiB)
STORAGE_FILE_SIZE_LIMIT=52428800


############
# Functions (profile: functions)
############

FUNCTIONS_VERIFY_JWT=false


############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true
IMGPROXY_WORKERS=2


############
# Analytics (profile: analytics)
############

DOCKER_SOCKET_LOCATION=/var/run/docker.sock


############
# Memory limits (Docker mem_limit). Defaults shown; uncomment to override.
############

# DB_MEM_LIMIT=1g
# MINIO_MEM_LIMIT=512m
# STORAGE_MEM_LIMIT=256m
# IMGPROXY_MEM_LIMIT=256m
# STUDIO_MEM_LIMIT=512m
# META_MEM_LIMIT=256m
# AUTH_MEM_LIMIT=128m
# REST_MEM_LIMIT=128m
# API_GW_MEM_LIMIT=128m
# REALTIME_MEM_LIMIT=512m
# FUNCTIONS_MEM_LIMIT=512m
# ANALYTICS_MEM_LIMIT=1g
# VECTOR_MEM_LIMIT=256m
# SUPAVISOR_MEM_LIMIT=512m
